{
  "name": "authority-diff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:boundaries": "depcruise packages",
    "lint:boundaries:prove": "tsx scripts/prove-boundaries.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
