{
  "name": "authority-diff",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware",
    "lint:prove": "tsx scripts/prove-lint.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:boundaries": "tsx scripts/cruise-boundaries.ts",
    "lint:boundaries:prove": "tsx scripts/prove-boundaries.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:int:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:int:db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:measure": "tsx tools/local-pipeline/measure.ts",
    "dev:replay-local": "tsx tools/local-pipeline/replay-local.ts",
    "dev:policy-init": "tsx tools/local-pipeline/policy-init.ts",
    "authority": "tsx apps/cli/src/main.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:boundaries && pnpm lint:prove && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dependency-cruiser": "^18.3.1",
    "drizzle-kit": "0.31.11",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --check"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.5.1"
}
