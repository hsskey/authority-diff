{
  "schemaVersion": 1,
  "environment": {
    "credentialPaths": ["~/.synthetic-credentials/**"],
    "agentConfigPaths": ["~/.synthetic-agent/**"],
    "trustedRemotes": ["trusted.example.invalid/**"],
    "publicRemotes": ["public.example.invalid/**"],
    "protectedBranches": ["main"],
    "productionMarkers": ["synthetic-production"]
  },
  "rules": [
    {
      "ruleId": "allow_workspace_writes",
      "match": {
        "capabilities": ["write"],
        "zones": ["workspace"],
        "reversibility": ["reversible"],
        "analyzability": ["full"]
      },
      "effect": "allow",
      "rationale": "Synthetic candidate allows known workspace writes."
    }
  ]
}
